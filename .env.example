# Copy to .env.local and fill in. Never commit .env.local.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where project enquiries are delivered
QUOTE_INBOX=info@jeffjencareplus.co.uk
# Sender address, on a domain verified in Resend
QUOTE_FROM=website@jeffjencareplus.co.uk

# Admin panel (/admin). Pick a long password; the secret is any random
# string (it signs the login cookie). Changing either logs you out.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Set automatically when you add Upstash Redis in Vercel → Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Set automatically when you add Blob in Vercel → Storage (portfolio images)
BLOB_READ_WRITE_TOKEN=
